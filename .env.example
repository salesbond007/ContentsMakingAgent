# --- LLM / 画像生成 ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- microCMS ---
MICROCMS_SERVICE_DOMAIN=your-service
MICROCMS_API_KEY=
MICROCMS_ARTICLES_ENDPOINT=articles
MICROCMS_KEYWORDS_ENDPOINT=keywords
# microCMS側でフィールドID(項目名)を変更した場合は config/microcms-fields.json を編集する。
# 別ファイルを使いたい場合のみ以下を設定(通常は不要)。
MICROCMS_FIELD_MAP_PATH=

# --- CTA(記事末尾の行動喚起リンク) ---
# 実在するCTAの一覧を config/ctas.json に登録する。別ファイルを使いたい場合のみ以下を設定(通常は不要)。
CTA_CONFIG_PATH=

# --- 文体の参考記事 ---
# お手本にしたい記事を config/style-references.json に登録する。別ファイルを使う場合のみ以下を設定(通常は不要)。
STYLE_REFERENCES_PATH=

# --- Slack ---
SLACK_WEBHOOK_URL=

# --- Googleドライブ（社内資料参照・任意） ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# --- 競合サイト・RSS（任意、カンマ区切り） ---
COMPETITOR_RSS_FEEDS=

# --- パイプライン設定（デフォルトは要件定義書の提案値） ---
DAILY_ARTICLE_COUNT=3
DAILY_API_CALL_CAP=4
REVIEW_AUTO_PUBLISH_THRESHOLD=80
REVIEW_NEEDS_CHECK_THRESHOLD=60
PUBLISH_TARGET_NAME=BondAIメディア

# --- 手動実行専用（GitHub Actionsの workflow_dispatch 入力から自動的に設定される。ローカルでは通常未設定でよい） ---
MANUAL_KEYWORD=
MANUAL_CTA_ID=
MANUAL_SOURCE_URLS=
