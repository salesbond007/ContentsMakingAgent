# ログイン用の共有パスワード(社内メンバーに共有する)
ADMIN_PASSWORD=

# セッションCookieの署名に使うランダムな文字列(推測されにくい長い文字列を生成して設定)
SESSION_SECRET=

# GitHubへの書き込み・Actions実行に使うPersonal Access Token
# 権限: このリポジトリへの Contents(read/write)・Actions(read/write)・Variables(read/write)
GITHUB_TOKEN=
GITHUB_OWNER=salesbond007
GITHUB_REPO=ContentsMakingAgent

# --- メールでのログイン(マジックリンク) ---
# Resend(https://resend.com/)のAPIキー。無料枠で十分足りる想定。
RESEND_API_KEY=
# 送信元表示(独自ドメインをResendで検証していない場合は既定の onboarding@resend.dev のままでよい)
MAIL_FROM=BondAIメディア管理画面 <onboarding@resend.dev>
# このドメインのメールアドレスのみログインリンクを送信する
ALLOWED_EMAIL_DOMAIN=salesbond.jp

# --- 数値解析画面(公開記事数の集計)用。パイプライン本体と同じmicroCMSの値を設定する ---
# 公開APIキーで十分(下書きは読み取れないため、公開数の集計に都合が良い)
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
MICROCMS_ARTICLES_ENDPOINT=articles
